<?xml version="1.0" encoding="utf-8"?>
<!-- The game's own icon, inset to the 66dp safe zone of the 108dp adaptive layer so launcher masks
     never clip the logo. Its black square blends into the black background layer. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground>
        <inset android:drawable="@drawable/vcs_icon" android:inset="21dp"/>
    </foreground>
</adaptive-icon>
