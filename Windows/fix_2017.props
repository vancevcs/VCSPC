<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets" />
	<PropertyGroup Condition="'$(WindowsTargetPlatformVersion)'=='10.0'">
	<!-- Latest Target Version property -->
	<LatestTargetPlatformVersion>$([Microsoft.Build.Utilities.ToolLocationHelper]::GetLatestSDKTargetPlatformVersion('Windows', '10.0'))</LatestTargetPlatformVersion>
	<WindowsTargetPlatformVersion Condition="'$(WindowsTargetPlatformVersion)' == '10.0'">$(LatestTargetPlatformVersion)</WindowsTargetPlatformVersion>
	<TargetPlatformVersion>$(WindowsTargetPlatformVersion)</TargetPlatformVersion>
	</PropertyGroup>
	<!-- Fork-specific: __FILE__ relative to the checkout, the MSVC side of -ffile-prefix-map in
	     CMakeLists.txt. Without it a published exe carries the full path of the folder it was built
	     in. /d1trimfile is undocumented but long-standing; an older compiler ignores it with D9002. -->
	<PropertyGroup>
		<VCSSourceRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\'))</VCSSourceRoot>
		<!-- UI and PPSSPP set their compile options to this outright, without %(AdditionalOptions). -->
		<EXTERNAL_COMPILE_OPTIONS>/d1trimfile:$(VCSSourceRoot) $(EXTERNAL_COMPILE_OPTIONS)</EXTERNAL_COMPILE_OPTIONS>
	</PropertyGroup>
	<!-- The linker writes the .pdb's full path into the exe as well, which /d1trimfile cannot reach.
	     /PDBALTPATH:%_PDB% records the file name alone; %25 is MSBuild's escape for a literal %. -->
	<ItemDefinitionGroup>
		<ClCompile>
			<AdditionalOptions>/d1trimfile:$(VCSSourceRoot) %(AdditionalOptions)</AdditionalOptions>
		</ClCompile>
		<Link>
			<AdditionalOptions>/PDBALTPATH:%25_PDB%25 %(AdditionalOptions)</AdditionalOptions>
		</Link>
	</ItemDefinitionGroup>
  <ItemGroup />
</Project>
